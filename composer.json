{
    "name": "toastnz/mercury",
    "type": "silverstripe-project",
    "version": "1.0.0",
    "description": "Toast NZ SilverStripe Installer",
    "require": {
        "php": ">=8.3",
        "silverstripe/recipe-cms": "^6",
        "undefinedoffset/silverstripe-nocaptcha": "^3.0",
        "symbiote/silverstripe-gridfieldextensions": "^5.0",
        "wilr/silverstripe-googlesitemaps": "^4.0",
        "silverstripe/taxonomy": "^4.0",
        "symbiote/silverstripe-queuedjobs": "^6.0",
        "silverstripe/crontask": "^4.0",
        "silverstripe/userforms": "^7.0",
        "silverstripe/tagfield": "^4.0",
        "undefinedoffset/sortablegridfield": "^3.0",
        "axllent/silverstripe-form-fields": "^2.0",
        "jonom/focuspoint": "^6.0",
        "silverstripe/redirectedurls": "^4.0",
        "bummzack/sortablefile": "^3.0",
        "stevie-mayhew/silverstripe-svg": "^3.0",
        "dnadesign/silverstripe-elemental": "^6.0",
        "symfony/sendgrid-mailer": "^7.3",
        "symfony/http-client": "^7.3",
        "atwx/silverstripe-vitehelper": "^1.1",
        "toastnz/favicon": "^3.0",
        "silverstripe/linkfield": "^5.0",
        "silverstripe/htmleditor-tinymce": "^1.0"
    },
    "extra": {
        "resources-dir": "_resources",
        "project-files-installed": [
            "app/.htaccess",
            "app/_config.php",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ],
        "expose": [
            "themes/mercury/dist",
            "app/cms/javascript"
        ]
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true,
            "php-http/discovery": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
